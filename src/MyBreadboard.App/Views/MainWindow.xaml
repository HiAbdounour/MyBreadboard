<Window x:Class="MyBreadboard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Breadboard"
        Width="1200"
        Height="800"
        WindowState="Maximized"
        Background="#111111"
        PreviewKeyDown="Window_PreviewKeyDownWithRotation">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#2A2A2A" Foreground="White">
            <MenuItem Header="Fichier">
                <MenuItem Header="Nouveau" />
                <MenuItem Header="Ouvrir" />
                <MenuItem Header="Enregistrer" />
                <Separator />
                <MenuItem Header="Fermer" />
            </MenuItem>
            <MenuItem Header="Édition">
                <MenuItem Header="Copier" />
                <MenuItem Header="Coller" />
                <MenuItem Header="Supprimer" />
                <MenuItem Header="Tout sélectionner" />
            </MenuItem>
            <MenuItem Header="Affichage">
                <MenuItem Header="Zoom +" />
                <MenuItem Header="Zoom -" />
            </MenuItem>
            <MenuItem Header="Aide">
                <MenuItem Header="À propos" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#BDBDBD" Padding="12"
                BorderBrush="#555555" BorderThickness="1">
            <WrapPanel>
                <Button Width="60" Height="60" Margin="5" Content="⏻" FontSize="24" ToolTip="Générateur de tension" />
                <Button Width="60" Height="60" Margin="5" Content="⊟" FontSize="24" ToolTip="Générateur de courant" />
                <Button Width="60" Height="60" Margin="5" Content="◫" FontSize="24" ToolTip="Résistance" />
                <Button Width="60" Height="60" Margin="5" Content="⎇" FontSize="24" ToolTip="Diode" />
                <Button Width="60" Height="60" Margin="5" Content="◌" FontSize="24" ToolTip="LED" />
                <Button Width="60" Height="60" Margin="5" Content="▣" FontSize="24" ToolTip="Interrupteur / bouton poussoir" />
                <Button Width="60" Height="60" Margin="5" Content="—" FontSize="24" ToolTip="Fil" />
                <Button Width="60" Height="60" Margin="5" Content="T" FontSize="24" ToolTip="Annotation" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="#0B0B0B"
                BorderBrush="#444444" BorderThickness="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="DrawingSurface"
                        Width="3000"
                        Height="2000"
                        Background="#F0F0F0"
                        Margin="10" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
